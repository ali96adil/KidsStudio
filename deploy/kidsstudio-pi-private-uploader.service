# M64 EXAMPLE, do not enable until supervised owner-device qualification.
# Place after reviewing local paths, system service account, OAuth env file.
[Unit]
Description=Kids Studio Pi PRIVATE-only YouTube uploader (M64)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=kidsstudio
Group=kidsstudio
WorkingDirectory=/opt/KidsStudio
Environment=PYTHONUNBUFFERED=1
# File owned root:root mode 0600, read by systemd into service environment.
EnvironmentFile=/etc/kidsstudio/pi-youtube-oauth.env
ExecStart=/usr/bin/python3 -m kidsstudio.pi_recovery_uploader --db /var/lib/kidsstudio/studio.sqlite --inbox-root /var/lib/kidsstudio/upload-inbox --journal /var/lib/kidsstudio/pi-upload.sqlite --loop --poll-seconds 30 --execute
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kidsstudio
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
